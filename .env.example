# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Postgres connection string from a free Supabase project (Project Settings > Database >
# Connection string > Transaction pooler). This is what keeps the tracked list, watchlists,
# and alerts alive across restarts/redeploys, unlike the old local SQLite file.
DATABASE_URL=

# Optional: paste a single server (guild) ID here during development.
# Slash commands sync instantly to this one server instead of taking up
# to an hour to propagate globally. Leave blank once you're ready to
# invite the bot to multiple servers / go "live".
DEV_GUILD_ID=

# Free API key from https://finnhub.io/register
# Used for analyst ratings and company news.
FINNHUB_API_KEY=

# Free API key from https://www.alphavantage.co/support/#api-key
# Used as a backup source for the analyst price target, since Finnhub
# only gives that out on a paid plan. Free tier is 25 requests/day, so
# we cache each ticker's result for 24 hours.
ALPHA_VANTAGE_API_KEY=

# Free API key from https://aistudio.google.com (no credit card needed).
# Used to generate the "Analyst Take" summary in /rating, explaining
# why a stock has the rating it does.
GEMINI_API_KEY=

# Channel ID where scheduled market-mover / news updates get posted.
# Enable Developer Mode in Discord (User Settings > Advanced), then
# right-click a channel > Copy Channel ID.
UPDATES_CHANNEL_ID=
